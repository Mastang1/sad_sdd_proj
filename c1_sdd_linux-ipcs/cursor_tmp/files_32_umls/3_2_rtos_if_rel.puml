@startuml
!pragma layout elk
top to bottom direction
skinparam backgroundColor #FFFCF5
skinparam component {
  BackgroundColor #F5E6CC
  BorderColor #8B7355
  FontSize 10
}
skinparam package {
  BackgroundColor #FAF0E0
  BorderColor #A08060
}
skinparam arrowColor #5C4033
() "IF_AppSvc" as IF_APP
() "IF_OSAbst" as IF_OS
() "IF_HWAbst" as IF_HW

component "APP" as APP
component "SWU_IPCS_CORE_SHM" as CORE_SHM <<Implement>>
component "SWU_IPCS_CORE_QUEUE" as CORE_Q <<Implement>>
component "SWU_IPCS_OSAL_AUTOSAR" as OS_AR <<Implement>>
component "SWU_IPCS_OSAL_FREERTOS" as OS_FR <<Implement>>
component "SWU_IPCS_OSAL_THREADX" as OS_TX <<Implement>>
component "SWU_IPCS_HAL_MCU" as HAL <<Implement>>

APP -down-> IF_APP
CORE_SHM -up-> IF_APP
CORE_Q -up-> CORE_SHM
CORE_SHM -down-> IF_OS
CORE_SHM -down-> IF_HW
OS_AR -up-> IF_OS
OS_FR -up-> IF_OS
OS_TX -up-> IF_OS
HAL -up-> IF_HW
OS_FR -down-> IF_HW

APP -[hidden]down- IF_APP
IF_APP -[hidden]down- CORE_SHM
CORE_Q -[hidden]left- CORE_SHM
CORE_SHM -[hidden]down- IF_OS
IF_OS -[hidden]right- IF_HW
IF_OS -[hidden]down- OS_FR
OS_AR -[hidden]left- OS_FR
OS_TX -[hidden]right- OS_FR
IF_HW -[hidden]down- HAL
@enduml
