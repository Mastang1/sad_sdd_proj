@startuml
skinparam backgroundColor #FFFCF5
skinparam component {
  BackgroundColor #F5E6CC
  BorderColor #8B7355
  FontSize 11
}
skinparam package {
  BackgroundColor #FAF0E0
  BorderColor #A08060
}
skinparam arrowColor #5C4033
skinparam note {
  BackgroundColor #FFF8E8
  BorderColor #B89968
}
component [ipc-cdev.h] as SRC
component [linux/ioctl.h] as H0 <<linux>>
component [sys/ioctl.h] as H1 <<posix>>
SRC ..> H0
SRC ..> H1
note bottom of SRC : ioctl 命令定义
@enduml
