@startuml
skinparam backgroundColor #FFFCF5
skinparam component {
  BackgroundColor #F5E6CC
  BorderColor #8B7355
  FontSize 11
}
skinparam package {
  BackgroundColor #FAF0E0
  BorderColor #A08060
}
skinparam arrowColor #5C4033
skinparam note {
  BackgroundColor #FFF8E8
  BorderColor #B89968
}
component [ipc-os.h] as SRC
component [errno.h] as H0 <<posix>>
component [stdint.h] as H1 <<posix>>
component [stdbool.h] as H2 <<posix>>
component [string.h] as H3 <<posix>>
component [stdio.h] as H4 <<posix>>
SRC ..> H0
SRC ..> H1
SRC ..> H2
SRC ..> H3
SRC ..> H4
note bottom of SRC : 用户侧 OSAL 头；无 ipcs 内其他头
@enduml
