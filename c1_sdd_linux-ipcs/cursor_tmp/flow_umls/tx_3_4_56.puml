@startuml
!pragma layout smetana
skinparam conditionStyle insideDiamond
skinparam linetype ortho
start
:err = -IPC_SHM_E_INVAL;
if ((rx_cb != NULL) and (cfg != NULL)?) then (yes)
  :save localShm remoteShm state=ENABLED rxCallback rxIrqNum;
  if ((taskIsInitialized != 0) or (rxIrqNum == IPC_IRQ_NONE)?) then (yes)
    :err = IPC_SHM_E_OK;
  else (no)
    :osStatus = tx_event_flags_create(&softIrqEvents, SOFT_ISR_NAME);
    if (osStatus != TX_SUCCESS?) then (yes)
      :err = -IPC_SHM_E_NOMEM;
    else (no)
      :osStatus = tx_thread_create(&softIrqHandle, SOFT_ISR_NAME, ipcsShmSoftIrq, ...);
      if (osStatus != TX_SUCCESS?) then (yes)
        :err = -IPC_SHM_E_NOMEM;
      else (no)
        :taskIsInitialized = 1;
        :err = IPC_SHM_E_OK;
      endif
    endif
  endif
else (no)
endif
:return err;
stop
@enduml
