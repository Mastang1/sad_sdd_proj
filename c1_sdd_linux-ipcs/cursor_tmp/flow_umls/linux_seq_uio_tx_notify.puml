@startuml
skinparam backgroundColor #FFFCF5
skinparam sequenceArrowThickness 1.2
skinparam sequence {
  ArrowColor #5C4033
  LifeLineBorderColor #8B7355
  ParticipantBorderColor #8B7355
  BoxBorderColor #A08060
}
skinparam note {
  BackgroundColor #FFF8E8
  BorderColor #B89968
}
skinparam actor {
  BackgroundColor #FAF0E0
  BorderColor #8B7355
}
participant "SWU_IPCS_CORE_SHM (user lib)" as CORE #D4E6F1
participant "SWU_IPCS_LINUX_OS_UIO (os_uio/ipc-os.c)" as UIO_USR #FCF3CF
participant "SWU_IPCS_LINUX_UIO_KO (ipc-uio.c)" as UIO_KO #FDEBD0
participant "SWU_IPCS_HAL_LINUX (ipc-hw.c)" as HAL #F5E6CC
participant "Remote core (peer)" as REMOTE #E8DAEF

autonumber
activate CORE
CORE -> UIO_USR : ipcsHwIrqNotify(instance) from ipcsShmTx
activate UIO_USR
UIO_USR -> UIO_USR : ipcsSendUioCmd(uio_fd, TRIGGER)
UIO_USR -> UIO_KO : write / UIO irqcontrol
activate UIO_KO
UIO_KO -> HAL : ipcsHwIrqNotify(instance)
activate HAL
HAL -> REMOTE : MSCM directed interrupt
activate REMOTE
deactivate REMOTE
deactivate HAL
deactivate UIO_KO
deactivate UIO_USR
deactivate CORE
@enduml
