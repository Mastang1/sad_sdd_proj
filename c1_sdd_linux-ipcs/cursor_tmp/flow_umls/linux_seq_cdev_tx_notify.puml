@startuml
skinparam backgroundColor #FFFCF5
skinparam sequenceArrowThickness 1.2
skinparam sequence {
  ArrowColor #5C4033
  LifeLineBorderColor #8B7355
  ParticipantBorderColor #8B7355
  BoxBorderColor #A08060
}
skinparam note {
  BackgroundColor #FFF8E8
  BorderColor #B89968
}
skinparam actor {
  BackgroundColor #FAF0E0
  BorderColor #8B7355
}
participant "SWU_IPCS_CORE_SHM (user lib)" as CORE #D4E6F1
participant "SWU_IPCS_LINUX_OS_CDEV (os_cdev/ipc-os.c)" as CDEV_USR #FCF3CF
participant "SWU_IPCS_LINUX_CDEV_KO (ipc-cdev.c)" as CDEV_KO #FDEBD0
participant "SWU_IPCS_HAL_LINUX (ipc-hw.c)" as HAL #F5E6CC
participant "Remote core (peer)" as REMOTE #E8DAEF

autonumber
activate CORE
CORE -> CDEV_USR : ipcsHwIrqNotify(instance)
activate CDEV_USR
CDEV_USR -> CDEV_KO : ioctl(TRIGGER_TX_IRQ, instance)
activate CDEV_KO
CDEV_KO -> HAL : ipcsHwIrqNotify(instance)
activate HAL
HAL -> REMOTE : MSCM directed interrupt
activate REMOTE
deactivate REMOTE
deactivate HAL
deactivate CDEV_KO
deactivate CDEV_USR
deactivate CORE
@enduml
